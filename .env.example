# Copie para .env e preencha com os dados do projeto Supabase (Settings → API)
# Este arquivo NÃO vai para o GitHub (.gitignore).
# Na publicação automática (GitHub Actions), cadastre os mesmos valores como Secrets:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: chave service_role apenas no servidor Flask (NUNCA no APK)
# SUPABASE_SERVICE_KEY=

# Repositório GitHub para embutir no APK (owner/repo) — usado na verificação de atualização
# GITHUB_REPO=seu-usuario/bba

# No build do APK, SUPABASE_URL/ANON_KEY são embutidos em sync-config.js
# (Perfil no celular ainda pode sobrescrever).
# Fotos usam o bucket Storage "vistoria-fotos" (veja scripts/supabase_schema.sql).
